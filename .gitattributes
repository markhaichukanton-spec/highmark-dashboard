# Normalize line endings: store everything as LF in the repo, regardless of OS.
# Silences the "LF will be replaced by CRLF" warnings and keeps the Cloud
# Function / Python pipeline (run on Linux) consistent.
* text=auto eol=lf

# Shell scripts must stay LF (CRLF breaks the shebang on Linux)
*.sh text eol=lf

# Binary assets — never normalize or diff as text
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.gif  binary
*.mp4  binary
*.pdf  binary
*.zip  binary
*.ico  binary
*.woff  binary
*.woff2 binary
